# Eidra's settings. Eidra reads them from the environment; it does not load this file itself.
# Copy it to .env, fill it in, and export it into your shell before you run eidra:
#
#     cp .env.example .env
#     set -a; . ./.env; set +a
#
# .env is git-ignored. Never commit a real key.

# The model server's API key. The built-in profile reads it from this variable.
# Leave it empty if your server needs no key.
RADIANCE_API_KEY=

# Another server or model than the built-in profile's. Uncomment to use them.
# EIDRA_BASE_URL=http://127.0.0.1:8000/v1
# EIDRA_MODEL=qwen3.8-flash-next

# For an https server with a certificate of its own, such as `eidra relay --listen` makes:
# the certificate's SHA-256 pin, which the relay prints when it starts.
# EIDRA_TLS_PIN=sha256:replace-with-the-pin-the-relay-prints

# A profile directory of your own (profile.toml and system.md) instead of the built-in one.
# EIDRA_PROFILE=/path/to/my-profile

# Eidra's own directory, for your AGENTS.md, session logs and checkpoints. Default: ~/.eidra
# EIDRA_HOME=/path/to/eidra-home

# Where session logs go. Default: ~/.eidra/sessions
# EIDRA_SESSION_DIR=/path/to/sessions

# For scripts/eidra-docker: the image to run (default: eidra), and the skills folder it mounts
# read-only (default: ~/.agents/skills).
# EIDRA_IMAGE=eidra
# EIDRA_SKILLS=/path/to/skills
