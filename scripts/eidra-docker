#!/usr/bin/env bash
# Runs eidra in its container on the current directory: the interactive session with no arguments,
# or any eidra command (scripts/eidra-docker exec "make the tests pass"). Build the image first:
# docker build -t eidra .
#
# The directory is mounted at the same path, so paths read the same inside and out, and so is
# eidra's own directory, ~/.eidra: your AGENTS.md, session logs and checkpoints. uv's cache is the
# host's ~/.cache/uv. Commands run as you, so files the agent writes are yours. The host's network
# is shared, since radiance listens on the host's localhost.
set -euo pipefail

image=${EIDRA_IMAGE:-eidra}
eidra_home=${EIDRA_HOME:-$HOME/.eidra}
cache=${XDG_CACHE_HOME:-$HOME/.cache}/uv
mkdir -p "$eidra_home" "$cache"

args=(
  --rm -i --network host
  --user "$(id -u):$(id -g)"
  -v "$PWD:$PWD" -w "$PWD"
  -v "$eidra_home:$eidra_home" -e "EIDRA_HOME=$eidra_home"
  -v "$cache:$cache" -e "UV_CACHE_DIR=$cache"
  -e RADIANCE_API_KEY -e EIDRA_BASE_URL -e EIDRA_MODEL -e EIDRA_VAULT
  # The terminal as the host has it, for colours and keys.
  -e TERM -e COLORTERM
)
if [ -t 0 ] && [ -t 1 ]; then
  # Docker's own detach keys, ctrl+p then ctrl+q, would hold back every ctrl+p the TUI is sent.
  args+=(-t --detach-keys "ctrl-^,ctrl-q")
fi
# The host's time zone, for dates the agent reads or writes.
if [ -e /etc/localtime ]; then
  args+=(-v /etc/localtime:/etc/localtime:ro)
fi
# Your git identity, so the agent's commits are yours.
if [ -f "$HOME/.gitconfig" ]; then
  args+=(-v "$HOME/.gitconfig:/home/eidra/.gitconfig:ro")
fi
# A profile directory of your own goes in read-only.
if [ -n "${EIDRA_PROFILE:-}" ]; then
  profile=$(cd "$EIDRA_PROFILE" && pwd)
  args+=(-v "$profile:$profile:ro" -e "EIDRA_PROFILE=$profile")
fi

exec docker run "${args[@]}" "$image" "$@"
